{
  "eslint.validate": [
    "javascript",
    "typescript"
  ],
  "editor.formatOnSave": true,
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "files.exclude": {
    "**/.git": true,
    "**/.DS_Store": true,
    "node_modules": true,
    ".gitignore": true,
  },
  "javascript.format.enable": false,
  "typescript.format.enable": false,
  "prettier.ignorePath": ".prettierrc.json"
}